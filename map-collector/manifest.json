{
  "manifest_version": 3,
  "name": "WhatsApp Simple Outreach Map Collector",
  "version": "0.1.0",
  "description": "User-initiated Google Maps result collector for the outreach dashboard.",
  "permissions": ["storage"],
  "host_permissions": [
    "https://www.google.com/maps/*",
    "https://lead-gen-dashboard-backend.onrender.com/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://www.google.com/maps/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "background": { "service_worker": "background.js" }
}
